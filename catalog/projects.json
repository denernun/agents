{
  "roots": [
    "ERPCLASS",
    "NFECLASS",
    "MOBICLASS",
    "SHOPCLASS"
  ],
  "mcp": {
    "common": [
      "codegraph",
      "context7",
      "filesystem",
      "memorix"
    ],
    "skipIdes": {},
    "extra": [
      {
        "match": [
          "*-www",
          "*-ajuda"
        ],
        "servers": [
          "playwright"
        ]
      }
    ]
  },
  "families": {
    "nestjs": {
      "match": [
        "*-api",
        "*-auth",
        "*-sync",
        "*-hook",
        "*-cob-api"
