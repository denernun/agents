      "skills": [
        "nestjs-clean-architecture",
        "codegraph",
        "debug-issue",
        "explore-codebase",
        "refactor-safely",
        "review-changes"
      ],
      "mcp": [
        "mongodb",
        "openapi"
      ],
      "agentsTemplate": "nestjs.md",
      "cursorRule": "stack-pointer-nestjs.mdc",
      "extraRules": [
        "decorator-placement.mdc"
      ]
    },
    "angular": {
      "match": [
        "*-admin",
        "*-dash",
        "*-app",
        "*-cob"
      ],
      "skills": [
        "angular-coreui",
        "coreui-styling",
        "codegraph",
        "debug-issue",
        "explore-codebase",
        "refactor-safely",
        "review-changes"
      ],
      "mcp": [
        "playwright"
      ],
      "agentsTemplate": "angular.md",
      "cursorRule": "stack-pointer-angular.mdc",
      "extraRules": []
    },
    "delphi": {
      "match": [
        "*-erp"
      ],
      "skills": [
        "delphi-erpclass",
        "debug-issue",
        "explore-codebase",
        "refactor-safely",
        "review-changes"
      ],
      "mcp": [],
      "agentsTemplate": "delphi.md",
      "cursorRule": "stack-pointer-delphi.mdc",
      "extraRules": []
    },
    "minimal": {
      "match": [
        "*"
      ],
      "skills": [
        "codegraph",
        "debug-issue",
        "explore-codebase",
        "refactor-safely",
        "review-changes"
      ],
      "mcp": [],
      "agentsTemplate": "minimal.md",
      "cursorRule": null,
      "extraRules": []
    }
  },
  "commonSkills": [
    "using-agent-skills",
    "git-workflow-and-versioning",
