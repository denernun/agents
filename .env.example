# Local machine config — copy to .env and edit. .env is gitignored.
#
# Valid IDE names:
#   Cursor, VSCode, Kiro, OpenCode, Antigravity, Claude, Codex, Devin, Qoder
#
# AGENTHUB_IDES = allowlist (skills + MCP). Empty or "auto" = every IDE detected
# on this machine, minus AGENTHUB_EXCLUDE_IDES.
# AGENTHUB_EXCLUDE_IDES = never configure; Install deletes hub files for these.
#
# If a variable is omitted here, catalog/projects.json is the fallback.

AGENTHUB_IDES=Cursor,Kiro,OpenCode,Antigravity
AGENTHUB_EXCLUDE_IDES=VSCode,Claude,Codex,Devin

# Optional
# CONTEXT7_API_KEY=
# MDB_MCP_CONNECTION_STRING=mongodb://root:password@127.0.0.1:27017/erpclass?authSource=admin
