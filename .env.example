# AgentHub - configuracao POR MAQUINA.
# Copie para .env (nao vai no git) e ajuste. Variaveis ja definidas no
# ambiente (setx / CI) tem prioridade sobre este ficheiro.

# --- IDEs / agentes desta maquina ---------------------------------------
# Por padrao o catalog/projects.json manda (chaves "ides" + "excludeIdes").
# Descomente SO para forcar uma lista diferente NESTA maquina.
# Atencao: variavel definida (mesmo vazia) ou "auto" IGNORA o catalog e usa
# toda IDE detectada. Para so usar o catalog, deixe as duas comentadas.
# Validos: Cursor, VSCode, Kiro, OpenCode, Antigravity, Claude, Codex, Devin, Qoder
#AGENTHUB_IDES=Cursor,Claude,OpenCode
#AGENTHUB_EXCLUDE_IDES=

# --- context7 MCP ------------------------------------------------------
# Sem chave = rate limit publico. Pegue em https://context7.com/dashboard
CONTEXT7_API_KEY=

# --- MongoDB MCP (familia NestJS) ------------------------------------
# Default local igual ao src/config/.development.json das APIs.
MDB_MCP_CONNECTION_STRING=mongodb://root:password@127.0.0.1:27017/erpclass?authSource=admin

# --- ai-memory (memoria compartilhada entre agentes) ----------------
# https://github.com/akitaonrails/ai-memory
# Precisa do servidor rodando e do CLI `ai-memory` no PATH. Ex. (Windows):
#   docker run -d --name ai-memory --restart unless-stopped \
#     -p 127.0.0.1:49374:49374 -v ai-memory-data:/data \
#     akitaonrails/ai-memory:latest
# Com AI_MEMORY_ENABLED=1 o Install-AgentHub.ps1 roda, uma vez por agente
# detectado, `ai-memory install-mcp` + `install-hooks` (config GLOBAL do
# usuario, nao por projeto). Desligue pontualmente com -SkipAiMemory.
AI_MEMORY_ENABLED=0
AI_MEMORY_URL=http://127.0.0.1:49374
# Bearer token; deixe vazio no modo loopback-only (sem auth).
AI_MEMORY_TOKEN=
